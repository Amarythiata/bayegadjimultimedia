NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx

# Flux AzuraCast (HTTPS obligatoire : un flux en http serait bloqué par les
# navigateurs depuis une page sécurisée)
NEXT_PUBLIC_RADIO_STREAM_URL=https://radio.ansaroudinelinguere.com/listen/ansaroudinelinguere/radio.mp3

# Notification par email des messages de contact (Resend).
# Sans cette clé, les messages restent enregistrés en base et consultables
# dans le back-office : seule l'alerte par email est désactivée.
RESEND_API_KEY=re_xxxxx

# Adresse d'expédition. Tant que le domaine n'est pas vérifié chez Resend,
# laisser vide pour utiliser onboarding@resend.dev.
CONTACT_FROM_EMAIL=
